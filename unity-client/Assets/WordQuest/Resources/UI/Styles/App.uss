.app-root {
    flex-grow: 1;
    flex-direction: row;
    background-color: var(--forest-950);
    color: var(--ink);
}

.app-root.game-active {
    background-color: rgba(0, 0, 0, 0);
}

.navigation {
    width: 196px;
    padding: 24px 14px;
    background-color: var(--forest-800);
    border-right-width: 2px;
    border-right-color: var(--gold);
}

.brand {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--parchment-50);
    margin-bottom: 28px;
    -unity-text-align: middle-center;
}

.nav-button {
    min-height: 44px;
    margin-bottom: 8px;
    border-width: 0;
    border-radius: 10px;
    color: var(--parchment-50);
    background-color: rgba(255, 255, 255, 0.06);
    font-size: 16px;
}

.nav-button:hover,
.nav-button:focus {
    background-color: var(--forest-650);
    border-left-width: 4px;
    border-left-color: var(--gold);
}

.screen-content {
    flex-grow: 1;
}

.screen {
    flex-grow: 1;
    padding: 32px;
    background-color: var(--parchment-100);
    overflow: scroll;
}

.centered-screen {
    align-items: center;
    justify-content: center;
    background-color: var(--forest-950);
}

.panel {
    padding: 24px;
    background-color: var(--parchment-50);
    border-width: 2px;
    border-color: var(--parchment-300);
    border-radius: 18px;
}

.auth-card {
    width: 480px;
}

.hero {
    margin-bottom: 20px;
}

.home-hero {
    margin-bottom: 12px;
    border-color: var(--forest-500);
}

.home-hero-heading,
.home-task-layout {
    flex-direction: row;
}

.home-hero-heading {
    align-items: flex-start;
    justify-content: space-between;
}

.home-hero-copy,
.home-task-copy {
    flex-grow: 1;
}

.home-subtitle {
    margin-bottom: 12px;
}

.streak-badge {
    min-width: 172px;
    min-height: 36px;
    padding: 8px 12px;
    border-radius: 8px;
    background-color: var(--parchment-100);
    color: var(--forest-800);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.home-task-layout {
    align-items: stretch;
}

.home-task-copy {
    padding-right: 24px;
}

.task-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--forest-950);
    margin-bottom: 4px;
}

.task-meta,
.journey-progress-label,
.helper-text {
    color: rgb(92, 79, 55);
    white-space: normal;
}

.task-meta {
    font-size: 15px;
    margin-bottom: 8px;
}

.journey-progress-label {
    font-size: 14px;
    margin-bottom: 4px;
}

.continue-learning-button {
    width: 230px;
    min-height: 52px;
}

.daily-goal-card {
    width: 300px;
    min-height: 132px;
    padding: 16px;
    border-left-width: 2px;
    border-left-color: var(--parchment-300);
}

.daily-goal-card ProgressBar {
    margin-top: 8px;
    margin-bottom: 8px;
}

.home-section-title {
    margin-top: 14px;
    font-size: 19px;
}

.learning-action-grid {
    align-items: stretch;
}

.learning-action-button,
.reward-card {
    width: 260px;
    min-height: 116px;
}

.reward-card {
    margin-right: 12px;
    margin-bottom: 12px;
    padding: 16px;
}

.reward-button {
    min-height: 40px;
    margin-top: 8px;
}

.compact-status {
    min-height: 18px;
    margin-top: 4px;
}

.success-status {
    color: var(--success);
}

.error-status {
    color: var(--error);
}

.tool-grid .feature-button {
    width: 190px;
    min-height: 74px;
    padding: 12px;
    font-size: 14px;
}

.hero-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--forest-800);
    margin-bottom: 8px;
}

.subtitle {
    font-size: 16px;
    color: rgb(92, 79, 55);
    margin-bottom: 18px;
    white-space: normal;
}

.eyebrow {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--forest-650);
    margin-bottom: 6px;
}

.feature-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.feature-button {
    width: 230px;
    min-height: 108px;
    margin-right: 12px;
    margin-bottom: 12px;
    padding: 16px;
    white-space: normal;
    font-size: 17px;
    -unity-text-align: middle-left;
    background-color: var(--parchment-50);
    border-width: 2px;
    border-color: var(--parchment-300);
    border-radius: 12px;
    color: var(--ink);
}

.feature-button:hover,
.feature-button:focus {
    border-color: var(--forest-500);
    translate: 0 -2px;
}

.primary-tile {
    background-color: var(--forest-650);
    color: var(--parchment-50);
    border-color: var(--gold);
}

.primary-button,
.secondary-button,
.ghost-button {
    min-height: 46px;
    margin-top: 10px;
    border-radius: 12px;
    font-size: 16px;
    -unity-font-style: bold;
}

.primary-button {
    color: white;
    background-color: var(--forest-650);
    border-color: var(--forest-800);
}

.secondary-button {
    color: var(--forest-950);
    background-color: var(--gold);
    border-color: rgb(175, 124, 28);
}

.ghost-button {
    min-height: 46px;
    background-color: transparent;
}

.status-label {
    min-height: 24px;
    color: var(--error);
    margin-top: 8px;
    white-space: normal;
}

.progress-row {
    max-width: 520px;
}

.action-row {
    flex-direction: row;
    margin-top: 12px;
}

.filter-row {
    flex-direction: row;
    margin-bottom: 16px;
}

.journey-summary {
    flex-direction: row;
    margin-bottom: 12px;
    padding: 16px 20px;
    background-color: var(--parchment-50);
}

.journey-summary-item {
    min-width: 260px;
    margin-right: 32px;
}

.journey-summary-value {
    color: var(--forest-950);
    font-size: 17px;
    -unity-font-style: bold;
}

.filter-row > * {
    min-width: 220px;
    margin-right: 16px;
}

.section-title {
    margin-top: 18px;
    margin-bottom: 10px;
    color: var(--forest-800);
    font-size: 22px;
    -unity-font-style: bold;
}

.level-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.level-button {
    width: 136px;
    min-height: 92px;
    margin-right: 8px;
    margin-bottom: 8px;
    white-space: normal;
    border-radius: 10px;
    background-color: var(--parchment-50);
    border-color: var(--parchment-300);
}

.recommended-level {
    border-width: 3px;
    border-color: var(--gold);
    background-color: rgb(255, 245, 210);
    -unity-font-style: bold;
}

.level-button:disabled {
    color: rgb(104, 96, 80);
    background-color: rgb(225, 217, 196);
    border-color: rgb(178, 168, 145);
}

TextField {
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 16px;
}

TextField > TextInput {
    min-height: 42px;
    background-color: white;
    border-radius: 8px;
}

TextField:focus {
    border-width: 5px;
    border-color: var(--gold);
}

Button:focus {
    border-width: 5px;
    border-color: var(--gold);
}

.game-screen {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

.game-layer {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

.hud {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 18px;
    min-height: 58px;
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
}

.hud > * {
    margin-right: 18px;
}

.hud ProgressBar {
    flex-grow: 1;
}

.tutorial-banner {
    position: absolute;
    left: 260px;
    right: 260px;
    bottom: 22px;
    min-height: 70px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-color: var(--gold);
}

.modal-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 24, 17, 0.72);
}

.quiz-card,
.pause-card,
.result-card {
    width: 560px;
}

.result-card {
    border-color: var(--gold);
}

.learning-feedback-card {
    margin-bottom: 10px;
    padding: 14px 16px;
    border-left-width: 4px;
    border-left-color: var(--forest-500);
    background-color: var(--parchment-100);
}

.learning-summary {
    color: var(--forest-950);
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.result-primary-button {
    min-height: 52px;
}

.result-secondary-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.result-secondary-button {
    min-width: 158px;
    min-height: 42px;
    margin-right: 8px;
    margin-bottom: 8px;
}

.npc-chat-card {
    width: 760px;
    max-height: 760px;
}

.question-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--forest-800);
    margin-bottom: 18px;
    white-space: normal;
}

.quiz-option {
    min-height: 48px;
    margin-bottom: 8px;
    border-radius: 10px;
    background-color: white;
    border-color: var(--parchment-300);
    white-space: normal;
}

.stars-label {
    font-size: 52px;
    color: var(--gold);
    -unity-text-align: middle-center;
    margin-top: 10px;
    margin-bottom: 18px;
}

.list-card {
    margin-bottom: 8px;
    padding: 14px;
    background-color: var(--parchment-50);
    border-width: 1px;
    border-color: var(--parchment-300);
    border-radius: 10px;
    white-space: normal;
    font-size: 16px;
}

.mode-question-host {
    max-width: 720px;
    margin-top: 14px;
}

.mode-question-host > Button {
    min-height: 48px;
    margin-top: 8px;
    white-space: normal;
    border-radius: 10px;
}

.mode-feedback-correct {
    color: var(--success);
}

.mode-feedback-wrong {
    color: var(--error);
}

.mode-selected {
    border-width: 3px;
    border-color: var(--forest-500);
    background-color: rgb(224, 240, 215);
}

.achievement-toast {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 360px;
    padding: 16px;
    border-width: 2px;
    border-color: var(--gold);
    border-radius: 12px;
    background-color: var(--forest-800);
    color: white;
}

.achievement-toast #achievement-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--gold);
}

.chart-slot {
    min-height: 240px;
}

.bounded-list {
    max-height: 360px;
    margin-top: 12px;
    margin-bottom: 18px;
}

.current-user-row {
    border-width: 2px;
    border-color: var(--gold);
    background-color: rgb(255, 246, 205);
}

.context-chip {
    align-self: flex-start;
    padding: 6px 12px;
    margin-bottom: 10px;
    border-radius: 12px;
    background-color: var(--forest-650);
    color: white;
}

.chat-list {
    flex-grow: 1;
    min-height: 320px;
    max-height: 560px;
    margin-bottom: 12px;
}

.chat-message {
    max-width: 720px;
    margin-bottom: 10px;
    padding: 12px 14px;
    border-radius: 12px;
    background-color: var(--parchment-50);
}

.user-message {
    align-self: flex-end;
    background-color: var(--forest-650);
    color: white;
}

.assistant-message {
    align-self: flex-start;
    border-width: 1px;
    border-color: var(--parchment-300);
}

.chat-body {
    margin-top: 4px;
    white-space: normal;
    font-size: 16px;
}
